; Engine configuration file.
; Cessna 172S G1000 Flight Simulator
; Godot Engine 4.3+
;
; To edit: open this folder in the Godot 4 editor.

config_version=5

[application]

config/name="Cessna 172S G1000 Flight Simulator"
config/description="A flight simulator for the Cessna 172S Skyhawk with a G1000 glass cockpit. Balances aerodynamic realism with playability. Runs on macOS, Linux and Windows."
run/main_scene="res://src/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

FlightData="*res://src/systems/FlightData.gd"
Atmosphere="*res://src/systems/Atmosphere.gd"
Wind="*res://src/systems/Wind.gd"
AudioManager="*res://src/systems/AudioManager.gd"
Replay="*res://src/systems/Replay.gd"
InputSetup="*res://src/systems/InputSetup.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

